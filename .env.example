# LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
ZHIPU_API_KEY=xxx

# Backend
DEBUG=true
REDIS_URL=redis://redis:6379/0
MYSQL_URL=mysql+pymysql://career:career@mysql:3306/career_assistant

# JWT 认证密钥（生产必须改为随机强密钥）
JWT_SECRET_KEY=change-me-in-production

# Graph 执行总超时（秒）
GRAPH_TIMEOUT=600
